---
import type { Product, ProductVariant } from "../types/domain";

interface Props {
  product: Product;
}

interface QuantityBand {
  id: string;
  label: string;
  minQuantity: number;
  maxQuantity?: number | null;
  requiresQuote?: boolean;
}

const { product } = Astro.props;
const hasVariants = product.variants.length > 0;
const hasVolumeRules = product.volumeDiscountRules.length > 0;
const isMatrix = product.pricing.kind === "matrix_quote";
const formatCurrency = (value: number) =>
  new Intl.NumberFormat("pt-BR", {
    style: "currency",
    currency: "BRL",
  }).format(value);
const getVariantPrice = (variant: ProductVariant) => {
  if (product.needsPriceConfirmation || typeof variant.price !== "number") {
    return "Consultar";
  }
  return formatCurrency(variant.price);
};
const getServices = (variant: ProductVariant): string[] =>
  Array.isArray(variant.services)
    ? variant.services.filter(
        (service): service is string => typeof service === "string",
      )
    : [];
const getQuantityBands = (variant: ProductVariant): QuantityBand[] =>
  Array.isArray(variant.quantityBands)
    ? variant.quantityBands.filter(
        (band): band is QuantityBand =>
          typeof band === "object" &&
          band !== null &&
          "label" in band &&
          typeof band.label === "string",
      )
    : [];
---

{
  (hasVariants || hasVolumeRules) && (
    <section class="variant-section" aria-labelledby="variant-title">
      <div class="section-heading">
        <p class="eyebrow">Opções do produto</p>
        <h2 class="section-title" id="variant-title">
          Escolha os detalhes do pedido
        </h2>
        <p class="section-intro">
          As opções abaixo vêm do catálogo atual. A arte e a viabilidade são
          confirmadas no atendimento.
        </p>
      </div>

      {product.needsPriceConfirmation && (
        <p class="pending-note">
          Os valores destas opções ainda precisam de confirmação quanto ao
          escopo. Por segurança, o preço não é publicado nesta página.
        </p>
      )}

      {hasVariants && !isMatrix && (
        <div class="variant-table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Opção</th>
                <th scope="col">Valor</th>
              </tr>
            </thead>
            <tbody>
              {product.variants.map((variant) => (
                <tr>
                  <th scope="row">{variant.name}</th>
                  <td>{getVariantPrice(variant)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {hasVariants && isMatrix && (
        <div class="matrix-grid">
          {product.variants.map((variant) => (
            <article>
              <h3>{variant.name}</h3>
              <p class="matrix-label">Serviços disponíveis</p>
              <ul>
                {getServices(variant).map((service) => (
                  <li>{service}</li>
                ))}
              </ul>
              <p class="matrix-label">Faixas para orçamento</p>
              <p class="quantity-bands">
                {getQuantityBands(variant)
                  .map((band) => band.label)
                  .join(" · ")}
              </p>
            </article>
          ))}
        </div>
      )}

      {hasVolumeRules && (
        <div class="volume-rules">
          <h3>Condições por quantidade</h3>
          <ul>
            {product.volumeDiscountRules.map((rule) => (
              <li>
                <strong>
                  {rule.maxQuantity
                    ? `${rule.minQuantity} a ${rule.maxQuantity} unidades`
                    : `A partir de ${rule.minQuantity} unidades`}
                </strong>
                <span>{rule.label}</span>
              </li>
            ))}
          </ul>
          <p>
            As condições exatas são calculadas no orçamento, sem percentual
            presumido.
          </p>
        </div>
      )}
    </section>
  )
}

<style>
  .variant-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .pending-note {
    max-width: 48rem;
    margin: -1rem 0 1.5rem;
    border-left: 3px solid var(--color-honey);
    padding: 0.8rem 1rem;
    background: color-mix(in srgb, var(--color-honey) 22%, white);
    font-size: 0.875rem;
  }

  .variant-table-wrap {
    max-width: 52rem;
    overflow-x: auto;
    border: 1px solid rgb(73 66 56 / 0.16);
    border-radius: var(--radius-card);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-paper);
  }

  th,
  td {
    border-bottom: 1px solid rgb(73 66 56 / 0.12);
    padding: 0.9rem 1rem;
    text-align: left;
  }

  thead th {
    color: var(--color-sage-ink);
    background: color-mix(in srgb, var(--color-sage) 22%, white);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  tbody th {
    font-weight: 650;
  }

  tbody td {
    white-space: nowrap;
    font-weight: 800;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  .matrix-grid {
    display: grid;
    gap: 1rem;
  }

  .matrix-grid article {
    border-top: 4px solid var(--color-sky);
    border-radius: var(--radius-card);
    padding: 1.25rem;
    background: var(--color-paper);
  }

  .matrix-grid h3,
  .volume-rules h3 {
    margin-bottom: 1rem;
    font-size: 1.45rem;
  }

  .matrix-label {
    margin-bottom: 0.35rem;
    color: var(--color-sage-ink);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .matrix-grid ul {
    margin: 0 0 1rem;
    padding-left: 1.1rem;
  }

  .quantity-bands {
    margin: 0;
    font-size: 0.875rem;
  }

  .volume-rules {
    max-width: 52rem;
    margin-top: 1.5rem;
    border-radius: var(--radius-card);
    padding: 1.25rem;
    background: color-mix(in srgb, var(--color-sage) 24%, white);
  }

  .volume-rules ul {
    display: grid;
    gap: 0.65rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .volume-rules li {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid rgb(73 66 56 / 0.14);
    padding-bottom: 0.65rem;
  }

  .volume-rules p {
    margin: 0;
    font-size: 0.8125rem;
  }

  @media (min-width: 48rem) {
    .matrix-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
