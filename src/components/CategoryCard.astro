---
import { Image } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import type { ResolvedProductImage } from "../data/assets";
import type { Category } from "../types/domain";
import PlaceholderImage from "./PlaceholderImage.astro";

interface Props {
  category: Category;
  image?: ResolvedProductImage;
  tone: "sky" | "sage" | "honey" | "terracotta";
}

const { category, image, tone } = Astro.props;
const href = `/categorias/${category.slug}`;
---

<article class:list={["category-card", `tone-${tone}`]} data-reveal>
  <div class="category-image">
    {
      image ? (
        <Image
          src={image.src}
          alt={image.alt}
          widths={[360, 560, 760]}
          sizes="(min-width: 768px) 30vw, 92vw"
          loading="lazy"
        />
      ) : (
        <PlaceholderImage />
      )
    }
  </div>
  <div class="category-content">
    <h3>{category.name}</h3>
    <p>{category.description}</p>
    <a
      href={href}
      data-analytics-event="category_view"
      data-analytics-context={category.id}
    >
      Ver produtos
      <ArrowUpRight size={17} aria-hidden="true" />
    </a>
  </div>
</article>

<style>
  .category-card {
    display: grid;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgb(73 66 56 / 0.14);
    border-radius: var(--radius-card);
    background: var(--color-paper);
  }

  .category-image {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-cream);
  }

  .category-image :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 260ms ease;
  }

  .category-content {
    position: relative;
    padding: 1.4rem;
  }

  h3 {
    margin-bottom: 0.7rem;
    font-size: 1.65rem;
  }

  .category-content > p {
    margin-bottom: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 0.2rem;
    font-size: 0.875rem;
    font-weight: 750;
  }

  .tone-sky .category-content {
    background: color-mix(in srgb, var(--color-sky) 48%, white);
  }

  .tone-sage .category-content {
    background: color-mix(in srgb, var(--color-sage) 36%, white);
  }

  .tone-honey .category-content {
    background: color-mix(in srgb, var(--color-honey) 38%, white);
  }

  .tone-terracotta .category-content {
    background: color-mix(in srgb, var(--color-terracotta) 28%, white);
  }

  @media (hover: hover) and (pointer: fine) {
    .category-card:hover .category-image :global(img) {
      transform: scale(var(--motion-image-scale));
    }
  }

  @media (min-width: 48rem) {
    .category-content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      padding: 1.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-image :global(img) {
      transform: none !important;
    }
  }
</style>
