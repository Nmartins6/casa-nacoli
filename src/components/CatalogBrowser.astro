---
import { Search, SlidersHorizontal, X } from "@lucide/astro";
import { getProductSearchText } from "../data/catalog";
import type { Category, Product } from "../types/domain";
import EmptyState from "./EmptyState.astro";
import ProductCard from "./ProductCard.astro";

interface Props {
  products: Product[];
  categories: Category[];
}

const { products, categories } = Astro.props;
---

<div class="catalog-browser" data-catalog-browser>
  <form class="catalog-tools" data-catalog-form>
    <div class="search-field">
      <label for="catalog-search">Buscar no catálogo</label>
      <div class="search-control">
        <Search size={20} aria-hidden="true" />
        <input
          id="catalog-search"
          type="search"
          name="q"
          placeholder="Ex.: caneca com foto, uniforme, adesivo"
          autocomplete="off"
          data-catalog-search
        />
      </div>
    </div>

    <fieldset id="categorias" class="category-filters">
      <legend
        ><SlidersHorizontal size={18} aria-hidden="true" /> Categorias</legend
      >
      <div class="filter-options">
        <label>
          <input type="radio" name="categoria" value="" checked />
          <span>Todos</span>
        </label>
        {
          categories.map((category) => (
            <label>
              <input type="radio" name="categoria" value={category.id} />
              <span>{category.name}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="catalog-status">
      <p aria-live="polite" aria-atomic="true">
        <strong data-result-count>{products.length}</strong>
        <span data-result-label> produtos encontrados</span>
      </p>
      <button type="button" data-clear-filters hidden>
        <X size={16} aria-hidden="true" /> Limpar filtros
      </button>
    </div>
  </form>

  <div class="catalog-grid" data-product-grid>
    {
      products.map((product) => (
        <div
          data-catalog-item
          data-category={product.categoryId}
          data-search={getProductSearchText(product)}
        >
          <ProductCard {product} />
        </div>
      ))
    }
  </div>

  <div data-empty-state hidden>
    <EmptyState />
    <button
      class="button button-secondary empty-clear"
      type="button"
      data-empty-clear
    >
      Ver todos os produtos
    </button>
  </div>
</div>

<script>
  import { trackEvent } from "../scripts/analytics";
  import { normalizeSearchTerm } from "../utils/search";

  document
    .querySelectorAll<HTMLElement>("[data-catalog-browser]")
    .forEach((root) => {
      const form = root.querySelector<HTMLFormElement>("[data-catalog-form]");
      const search = root.querySelector<HTMLInputElement>(
        "[data-catalog-search]",
      );
      const categoryInputs = Array.from(
        root.querySelectorAll<HTMLInputElement>('input[name="categoria"]'),
      );
      const items = Array.from(
        root.querySelectorAll<HTMLElement>("[data-catalog-item]"),
      );
      const count = root.querySelector<HTMLElement>("[data-result-count]");
      const label = root.querySelector<HTMLElement>("[data-result-label]");
      const clearButton = root.querySelector<HTMLButtonElement>(
        "[data-clear-filters]",
      );
      const emptyClear =
        root.querySelector<HTMLButtonElement>("[data-empty-clear]");
      const emptyState = root.querySelector<HTMLElement>("[data-empty-state]");
      let searchTimer: number | undefined;

      if (!form || !search || !count || !label || !clearButton || !emptyState)
        return;

      const getCategory = () =>
        categoryInputs.find((input) => input.checked)?.value ?? "";

      const applyFilters = () => {
        const query = normalizeSearchTerm(search.value);
        const category = getCategory();
        let visible = 0;

        items.forEach((item) => {
          const matchesQuery =
            !query || (item.dataset.search ?? "").includes(query);
          const matchesCategory =
            !category || item.dataset.category === category;
          item.hidden = !(matchesQuery && matchesCategory);
          if (!item.hidden) visible += 1;
        });

        count.textContent = String(visible);
        label.textContent =
          visible === 1 ? " produto encontrado" : " produtos encontrados";
        emptyState.hidden = visible > 0;
        clearButton.hidden = !query && !category;

        const url = new URL(window.location.href);
        if (query) url.searchParams.set("q", search.value.trim());
        else url.searchParams.delete("q");

        if (category) url.searchParams.set("categoria", category);
        else url.searchParams.delete("categoria");
        window.history.replaceState({}, "", url);
      };

      const clearFilters = () => {
        search.value = "";
        const all = categoryInputs.find((input) => input.value === "");
        if (all) all.checked = true;
        applyFilters();
        search.focus();
      };

      const params = new URLSearchParams(window.location.search);
      search.value = params.get("q") ?? "";
      const requestedCategory = params.get("categoria") ?? "";
      const initialCategory = categoryInputs.find(
        (input) => input.value === requestedCategory,
      );
      if (initialCategory) initialCategory.checked = true;
      applyFilters();

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        applyFilters();
      });

      search.addEventListener("input", () => {
        applyFilters();
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => {
          if (search.value.trim()) {
            trackEvent({
              name: "catalog_search",
              context: search.value.trim(),
            });
          }
        }, 450);
      });

      categoryInputs.forEach((input) => {
        input.addEventListener("change", () => {
          applyFilters();
          trackEvent({ name: "filter_apply", context: input.value || "todos" });
        });
      });

      clearButton.addEventListener("click", clearFilters);
      emptyClear?.addEventListener("click", clearFilters);
    });
</script>

<style>
  .catalog-tools {
    margin-bottom: 2.5rem;
    border: 1px solid rgb(73 66 56 / 0.14);
    border-radius: var(--radius-card);
    padding: clamp(1rem, 3vw, 1.5rem);
    background: color-mix(in srgb, var(--color-sky) 28%, white);
  }

  .search-field label,
  legend {
    color: var(--color-espresso);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .search-field label {
    display: block;
    margin-bottom: 0.45rem;
  }

  .search-control {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid rgb(73 66 56 / 0.34);
    border-radius: 0.75rem;
    padding-inline: 0.9rem;
    background: white;
  }

  .search-control:focus-within {
    outline: 3px solid var(--color-terracotta);
    outline-offset: 3px;
  }

  .search-control input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    color: var(--color-espresso);
    background: transparent;
  }

  .category-filters {
    margin: 1.25rem 0 0;
    border: 0;
    padding: 0;
  }

  legend {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.65rem;
  }

  .filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-options label {
    position: relative;
  }

  .filter-options input {
    position: absolute;
    opacity: 0;
  }

  .filter-options span {
    display: inline-flex;
    min-height: 2.75rem;
    cursor: pointer;
    align-items: center;
    border: 1px solid rgb(73 66 56 / 0.25);
    border-radius: 999px;
    padding: 0.55rem 0.85rem;
    background: rgb(255 255 255 / 0.75);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .filter-options input:focus-visible + span {
    outline: 3px solid var(--color-terracotta);
    outline-offset: 3px;
  }

  .filter-options input:checked + span {
    border-color: var(--color-sage-ink);
    color: white;
    background: var(--color-sage-ink);
  }

  .catalog-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.25rem;
    border-top: 1px solid rgb(73 66 56 / 0.14);
    padding-top: 1rem;
  }

  .catalog-status p {
    margin: 0;
    font-size: 0.875rem;
  }

  .catalog-status button {
    display: inline-flex;
    cursor: pointer;
    align-items: center;
    gap: 0.35rem;
    border: 0;
    border-radius: 0.2rem;
    padding: 0.25rem;
    color: var(--color-terracotta-ink);
    background: transparent;
    font-size: 0.8125rem;
    font-weight: 750;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .catalog-grid {
    display: grid;
    gap: 2.75rem 1.25rem;
  }

  [data-catalog-item] {
    min-width: 0;
    height: 100%;
  }

  [hidden] {
    display: none !important;
  }

  .empty-clear {
    display: flex;
    width: fit-content;
    margin: -2rem auto 3rem;
  }

  @media (min-width: 40rem) {
    .catalog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .catalog-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
