---
import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import { getProductImages } from "../data/assets";
import { getCategory } from "../data/catalog";
import type { Product } from "../types/domain";
import PlaceholderImage from "./PlaceholderImage.astro";
import PriceDisplay from "./PriceDisplay.astro";

interface Props {
  product: Product;
  priority?: boolean;
}

const { product, priority = false } = Astro.props;
const image = getProductImages(product).at(0);
const category = getCategory(product.categoryId);
const productHref = `/produtos/${product.slug}`;
const categoryHref = category ? `/categorias/${category.slug}` : "/produtos";
---

<article class="product-card" data-product-card data-reveal>
  <a
    class="product-image"
    href={productHref}
    aria-label={`Ver ${product.name}`}
  >
    {
      image ? (
        <Image
          src={image.src}
          alt={image.alt}
          widths={[360, 560, 760]}
          sizes="(min-width: 1024px) 31vw, (min-width: 640px) 47vw, 92vw"
          loading={priority ? "eager" : "lazy"}
        />
      ) : (
        <PlaceholderImage />
      )
    }
  </a>
  <div class="product-content">
    <a class="product-category" href={categoryHref}>{category?.name}</a>
    <h3><a href={productHref}>{product.name}</a></h3>
    <p class="product-summary">{product.summary}</p>
    <div class="product-footer">
      <PriceDisplay {product} compact />
      <a
        class="product-link"
        href={productHref}
        aria-label={`Ver detalhes de ${product.name}`}
      >
        Ver detalhes
        <ArrowRight size={17} aria-hidden="true" />
      </a>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    height: 100%;
    min-width: 0;
    flex-direction: column;
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-card);
    padding: 0.625rem;
    background: var(--color-card-surface);
    box-shadow: 0 0 0 transparent;
    transition:
      border-color var(--motion-duration-card) var(--motion-ease-standard),
      box-shadow var(--motion-duration-card) var(--motion-ease-standard),
      transform var(--motion-duration-card) var(--motion-ease-standard);
  }

  .product-image {
    display: block;
    flex: none;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: calc(var(--radius-card) - 0.375rem);
    background: var(--color-paper);
  }

  .product-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform var(--motion-duration-card)
      var(--motion-ease-standard);
  }

  .product-content {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    padding: 1.15rem 0.5rem 0.55rem;
  }

  .product-category {
    display: inline-block;
    margin-bottom: 0.45rem;
    color: var(--color-terracotta-ink);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
  }

  h3 {
    margin-bottom: 0.6rem;
    font-size: 1.6rem;
  }

  h3 a {
    border-radius: 0.2rem;
    text-decoration: none;
  }

  .product-summary {
    margin-bottom: 1rem;
    font-size: 0.9375rem;
  }

  .product-footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .product-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 0.2rem;
    font-size: 0.875rem;
    font-weight: 750;
  }

  .product-link svg {
    transition: transform var(--motion-duration-fast)
      var(--motion-ease-standard);
  }

  .product-card:focus-within {
    border-color: var(--color-card-border-hover);
    box-shadow: var(--shadow-card-hover);
  }

  .product-link:focus-visible svg {
    transform: translateX(2px);
  }

  @media (hover: hover) and (pointer: fine) {
    .product-card:hover {
      border-color: var(--color-card-border-hover);
      box-shadow: var(--shadow-card-hover);
      transform: translateY(var(--motion-card-lift));
    }

    .product-card:hover .product-image :global(img) {
      transform: scale(var(--motion-image-scale));
    }

    .product-link:hover svg {
      transform: translateX(2px);
    }
  }

  @media (min-width: 75rem) {
    .product-footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-image :global(img),
    .product-link svg {
      transform: none !important;
    }
  }
</style>
