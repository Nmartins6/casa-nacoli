---
import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import { getProductImages } from "../data/assets";
import { getCategory } from "../data/catalog";
import type { Product } from "../types/domain";
import PlaceholderImage from "./PlaceholderImage.astro";
import PriceDisplay from "./PriceDisplay.astro";

interface Props {
  product: Product;
  priority?: boolean;
}

const { product, priority = false } = Astro.props;
const image = getProductImages(product).at(0);
const category = getCategory(product.categoryId);
const productHref = `/produtos/${product.slug}`;
const categoryHref = category ? `/categorias/${category.slug}` : "/produtos";
---

<article class="product-card">
  <a
    class="product-image"
    href={productHref}
    aria-label={`Ver ${product.name}`}
  >
    {
      image ? (
        <Image
          src={image.src}
          alt={image.alt}
          widths={[360, 560, 760]}
          sizes="(min-width: 1024px) 31vw, (min-width: 640px) 47vw, 92vw"
          loading={priority ? "eager" : "lazy"}
        />
      ) : (
        <PlaceholderImage />
      )
    }
  </a>
  <div class="product-content">
    <a class="product-category" href={categoryHref}>{category?.name}</a>
    <h3><a href={productHref}>{product.name}</a></h3>
    <p class="product-summary">{product.summary}</p>
    <div class="product-footer">
      <PriceDisplay {product} compact />
      <a
        class="product-link"
        href={productHref}
        aria-label={`Ver detalhes de ${product.name}`}
      >
        Ver detalhes
        <ArrowRight size={17} aria-hidden="true" />
      </a>
    </div>
  </div>
</article>

<style>
  .product-card {
    min-width: 0;
  }

  .product-image {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-paper);
  }

  .product-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 260ms ease;
  }

  .product-card:hover .product-image :global(img) {
    transform: scale(1.02);
  }

  .product-content {
    padding: 1.2rem 0.25rem 0;
  }

  .product-category {
    display: inline-block;
    margin-bottom: 0.45rem;
    color: var(--color-terracotta-ink);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
  }

  h3 {
    margin-bottom: 0.6rem;
    font-size: 1.6rem;
  }

  h3 a {
    border-radius: 0.2rem;
    text-decoration: none;
  }

  .product-summary {
    margin-bottom: 1rem;
    font-size: 0.9375rem;
  }

  .product-footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .product-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 0.2rem;
    font-size: 0.875rem;
    font-weight: 750;
  }

  @media (min-width: 75rem) {
    .product-footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
